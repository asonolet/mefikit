    def __add__(self, other: _FieldInput, /) -> Field: ...
    def __sub__(self, other: _FieldInput, /) -> Field: ...
    def __mul__(self, other: _FieldInput, /) -> Field: ...
    def __truediv__(self, other: _FieldInput, /) -> Field: ...
    def __radd__(self, other: _FieldInput, /) -> Field: ...
    def __rsub__(self, other: _FieldInput, /) -> Field: ...
    def __rmul__(self, other: _FieldInput, /) -> Field: ...
    def __rtruediv__(self, other: _FieldInput, /) -> Field: ...
    def __matmul__(self, other: _FieldInput, /) -> Field: ...
    def __rmatmul__(self, other: _FieldInput, /) -> Field: ...
    def dot(self, other: _FieldInput) -> Field: ...
    def __pow__(self, other: _FieldInput, mod: object = None, /) -> Field: ...
    def __rpow__(self, other: _FieldInput, mod: object = None, /) -> Field: ...
    def __getitem__(self, index: int, /) -> Field: ...
    def abs(self) -> Field: ...
    def tan(self) -> Field: ...
    def exp(self) -> Field: ...
    def cos(self) -> Field: ...
    def sin(self) -> Field: ...
    def log10(self) -> Field: ...
    def ln(self) -> Field: ...
    def square(self) -> Field: ...
    def sqrt(self) -> Field: ...
    def __gt__(self, other: _FieldInput, /) -> Selection: ...
    def __ge__(self, other: _FieldInput, /) -> Selection: ...
    def __lt__(self, other: _FieldInput, /) -> Selection: ...
