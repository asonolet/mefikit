    @staticmethod
    def identity() -> Transform: ...
    @staticmethod
    def translation(v: Sequence[float]) -> Transform: ...
    @staticmethod
    def scaling(factors: Sequence[float]) -> Transform: ...
    @staticmethod
    def rotation(axis: Sequence[float], angle: float) -> Transform: ...
    @staticmethod
    def rotation_about(
        center: Sequence[float], axis: Sequence[float], angle: float
    ) -> Transform: ...
    @staticmethod
    def reflection(normal: Sequence[float]) -> Transform: ...
    @staticmethod
    def reflection_about(
        point: Sequence[float], normal: Sequence[float]
    ) -> Transform: ...
