class ConformanceChecks(IntFlag):
    NONE = 0
    TOPOLOGY = 1
    BUTTERFLY = 2
    INTERSECTIONS = 4
    FACE_OVERLAP = 8
    FAST = 3
    FULL = 15

class DistanceWeighting:
    @final
    class Constant(DistanceWeighting):
        __match_args__ = ()
        def __new__(cls) -> DistanceWeighting.Constant: ...

    @final
    class InverseDistance(DistanceWeighting):
        exponent: float
        __match_args__ = ("exponent",)
        def __new__(cls, exponent: float) -> DistanceWeighting.InverseDistance: ...

    @final
    class CompactSupport(DistanceWeighting):
        exponent: float
        __match_args__ = ("exponent",)
        def __new__(cls, exponent: float) -> DistanceWeighting.CompactSupport: ...

    @final
    class Gaussian(DistanceWeighting):
        __match_args__ = ()
        def __new__(cls) -> DistanceWeighting.Gaussian: ...

# --- Helper type aliases ---

_Array1F: TypeAlias = npt.NDArray[np.float64]
_Array2F: TypeAlias = npt.NDArray[np.float64]
_Array1U: TypeAlias = npt.NDArray[np.uintp]
_Array2U: TypeAlias = npt.NDArray[np.uintp]
_ArrayDynF: TypeAlias = npt.NDArray[np.float64]

# Private connectivity alias:
# - Regular: (n_elem, n_nodes_per_elem)
# - Poly: (data, offsets)
_Connectivity: TypeAlias = _Array2U | tuple[_Array1U, _Array1U]

# Anything usable where a `Field` expression is expected.
_FieldInput: TypeAlias = str | float | _ArrayDynF | Field

# Anything usable as a value when assigning to a named field. A `str` must be
# the name of an existing field and copies it.
_FieldValue: TypeAlias = str | float | _ArrayDynF | dict[str, _ArrayDynF] | Field

# Anything usable where an element selector is expected. A `str` is a group
# name and selects that group's elements. `None`, `...` and `slice(None)` act
# as select-all wildcards.
_Selector: TypeAlias = (
    Selection | dict[str, Sequence[int]] | str | EllipsisType | slice | None
)

@final
class Selection:
    def __and__(self, other: Selection, /) -> Selection: ...
    def __rand__(self, other: Selection, /) -> Selection: ...
    def __or__(self, other: Selection, /) -> Selection: ...
    def __ror__(self, other: Selection, /) -> Selection: ...
    def __xor__(self, other: Selection, /) -> Selection: ...
    def __rxor__(self, other: Selection, /) -> Selection: ...
    def __sub__(self, other: Selection, /) -> Selection: ...
    def __rsub__(self, other: Selection, /) -> Selection: ...
    def __invert__(self) -> Selection: ...
    def nbbox(
        self, min: Sequence[float], max: Sequence[float], all: bool
    ) -> Selection: ...
    def nrect(
        self, min: Sequence[float], max: Sequence[float], all: bool
    ) -> Selection: ...
    def nsphere(self, center: Sequence[float], r: float, all: bool) -> Selection: ...
    def ncircle(self, center: Sequence[float], r: float, all: bool) -> Selection: ...
    def nids(self, ids: Sequence[int], all: bool) -> Selection: ...
    def bbox(self, min: Sequence[float], max: Sequence[float]) -> Selection: ...
    def rect(self, min: Sequence[float], max: Sequence[float]) -> Selection: ...
    def sphere(self, center: Sequence[float], r: float) -> Selection: ...
    def circle(self, center: Sequence[float], r: float) -> Selection: ...
    def group(self, name: str) -> Selection: ...
    def exclude_group(self, name: str) -> Selection: ...

@final
class SelectionResult:
    # Lazy result of `UMesh.select`; element ids are re-evaluated on every
    # call. Reductions accept field expressions and return one value per
    # element type.
    def ids(self) -> dict[str, _Array1U]: ...
    def to_mesh(self, with_fields: bool = True) -> UMesh: ...
    def __len__(self) -> int: ...
    def min(self, expr: _FieldInput) -> list[float | _ArrayDynF]: ...
    def max(self, expr: _FieldInput) -> list[float | _ArrayDynF]: ...
    def sum(self, expr: _FieldInput) -> list[float | _ArrayDynF]: ...
    def mean(self, expr: _FieldInput) -> list[float | _ArrayDynF]: ...
    def var(self, expr: _FieldInput, ddof: int = 0) -> list[float | _ArrayDynF]: ...
    def std(self, expr: _FieldInput, ddof: int = 0) -> list[float | _ArrayDynF]: ...
    def integral(self, expr: _FieldInput) -> list[float | _ArrayDynF]: ...

