@final
class FieldsMapping:
    # Dict-like view of the mesh fields, keyed by field name.
    def keys(self) -> list[str]: ...
    def values(self) -> list[FieldRef]: ...
    def items(self) -> list[tuple[str, FieldRef]]: ...
    def to_dict(self) -> dict[str, dict[str, _ArrayDynF]]: ...
    def rename(self, old_name: str, new_name: str) -> None: ...
    def __len__(self) -> int: ...
    def __contains__(self, name: str, /) -> bool: ...
    def __iter__(self) -> Iterator[str]: ...
    def __getitem__(self, name: str, /) -> FieldRef: ...
    def __setitem__(self, name: str, value: _FieldValue, /) -> None: ...
    def __delitem__(self, name: str, /) -> None: ...

@final
class FieldRef:
    # Handle on a named field; reductions cover all elements carrying it.
    @property
    def shape(self) -> tuple[int, ...]: ...
    def dimension(self) -> int: ...
    def len(self) -> int: ...
    def __len__(self) -> int: ...
    def numpy(self) -> _ArrayDynF: ...
    def values(self) -> dict[str, _ArrayDynF]: ...
    def __getitem__(self, sel: _Selector, /) -> dict[str, _ArrayDynF]: ...
    def __setitem__(self, sel: _Selector, value: _FieldValue, /) -> None: ...
    def min(self) -> float | _ArrayDynF: ...
    def max(self) -> float | _ArrayDynF: ...
    def sum(self) -> float | _ArrayDynF: ...
    def mean(self) -> float | _ArrayDynF: ...
    def var(self, ddof: int = 0) -> float | _ArrayDynF: ...
    def std(self, ddof: int = 0) -> float | _ArrayDynF: ...
    def integral(self) -> float | _ArrayDynF: ...

@final
class TimeSeriesMapping:
    # Dict-like view of the mesh time-series fields, keyed by base name. Steps
    # are stored as fields named "<base>_step_<n>_time_<t>".
    def keys(self) -> list[str]: ...
    def values(self) -> list[TimeSeries]: ...
    def items(self) -> list[tuple[str, TimeSeries]]: ...
    def __len__(self) -> int: ...
    def __contains__(self, base: str, /) -> bool: ...
    def __iter__(self) -> Iterator[str]: ...
    def __getitem__(self, base: str, /) -> TimeSeries: ...

@final
class TimeSeries:
    # A single time-series field: an ordered set of steps sharing a base name.
    # Indexing a mapping with an unknown base creates a handle; the series only
    # "exists" once its first step is added.
    @property
    def base(self) -> str: ...
    def dim(self) -> int: ...
    def steps(self) -> list[int]: ...
    def times(self) -> list[float]: ...
    def at(self, step: int) -> FieldRef: ...
    def at_time(self, time: float) -> FieldRef: ...
    def nearest(self, time: float) -> FieldRef: ...
    def latest(self) -> FieldRef: ...
    def add(
        self, value: _FieldValue, time: float, dim: int | None = None
    ) -> FieldRef: ...
    def set_time(self, step: int, time: float) -> None: ...
    def remove(self, step: int) -> None: ...
    def rename(self, new_base: str) -> None: ...
    def items(self) -> list[tuple[int, float, FieldRef]]: ...
    def __iter__(self) -> Iterator[tuple[float, FieldRef]]: ...
    def __len__(self) -> int: ...
    def __contains__(self, step: int, /) -> bool: ...
    def __getitem__(self, step: int, /) -> FieldRef: ...
    def __delitem__(self, step: int, /) -> None: ...

@final
class OverlayOperation:
    IMPRINT: OverlayOperation
    UNION: OverlayOperation
    INTERSECTION: OverlayOperation
    DIFFERENCE: OverlayOperation
    SYMMETRIC_DIFFERENCE: OverlayOperation

@final
class SurfaceOverlay:
    # Result of `UMesh.overlay_surfaces`: two refined, mutually conformal surfaces sharing one
    # coordinates array, plus the input-face -> produced-element maps.
    @property
    def refined1(self) -> UMesh: ...
    @property
    def refined2(self) -> UMesh: ...
    @property
    def parents1(self) -> dict[tuple[str, int], list[tuple[str, int]]]: ...
    @property
    def parents2(self) -> dict[tuple[str, int], list[tuple[str, int]]]: ...

@final
class ConformanceReport:
    # Result of `is_conform`: whether the mesh is conformal, and if not, why and where.
    # The check follows the topological dimension (3D faces, 2D edges); lower-dimensional
    # elements are ignored. Each issue is a dict: `kind` (butterfly_cell, merged_nodes,
    # overlapping_faces, non_conforming_faces, intersecting_cells, invalid_space_dimension,
    # unsupported_cells, no_volume_cells), the variant fields (`center`, `nodes`, `cells` /
    # `cells_a` / `cells_b` / `volume`, an area for 2D overlaps), and `message`.
    @property
    def is_conform(self) -> bool: ...
    @property
    def n_issues(self) -> int: ...
    @property
    def truncated(self) -> bool: ...
    @property
    def issues(self) -> list[dict[str, object]]: ...
    def __bool__(self) -> bool: ...

