    def __contains__(self, name: str, /) -> bool: ...
    def __iter__(self) -> Iterator[str]: ...
    def __getitem__(self, name: str, /) -> GroupRef: ...
    def __setitem__(
        self, name: str, source: Selection | dict[str, Sequence[int]] | str, /
    ) -> None: ...
    def __delitem__(self, name: str, /) -> None: ...

@final
class GroupRef:
