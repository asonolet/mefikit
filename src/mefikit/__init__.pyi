    def then(self, after: Transform) -> Transform: ...
    def inverse(self) -> Transform: ...
    def apply(self, mesh: UMesh) -> UMesh: ...
    def __matmul__(self, rhs: Transform, /) -> Transform: ...
    def __rmatmul__(self, rhs: Transform, /) -> Transform: ...

@final
class UMesh:
    def __new__(cls, coords: _Array2F) -> UMesh: ...

    # --- basic accessors ---

    def coords(self) -> _Array2F: ...
    def block_types(self) -> list[str]: ...
    def blocks(self) -> dict[str, _Connectivity]: ...
    @property
    def fields(self) -> FieldsMapping: ...
    @property
    def time_series(self) -> TimeSeriesMapping: ...
    @property
    def groups(self) -> GroupsMapping: ...
    def num_elements(self) -> int: ...

    # --- serialization ---

    def to_json(self) -> str: ...
    def to_json_pretty(self) -> str: ...
    @staticmethod
    def read(path: str) -> UMesh: ...
    def write(self, path: str) -> None: ...

    # --- mesh construction ---

    def add_regular_block(
        self,
        et: str,
        block: _Array2U,
        fields: dict[str, _ArrayDynF] | None = ...,
    ) -> None: ...
    def add_poly_block(
        self,
        et: str,
        conn: _Array1U,
        offsets: _Array1U,
        fields: dict[str, _ArrayDynF] | None = ...,
    ) -> None: ...
    @classmethod
    def from_mesh(
        cls,
        source: UMesh,
        coords: _Array2F | None = ...,
        *,
        dim: int | None = ...,
        element_types: Sequence[str] | None = ...,
    ) -> UMesh: ...
    @classmethod
    def from_mc(
        cls,
        mesh: mc.MEDCouplingUMesh | mc.MEDFileUMesh,
        fields: Sequence[mc.MEDCouplingFieldDouble] | None = ...,
    ) -> UMesh: ...
    def set_field(self, name: str, field: dict[str, _ArrayDynF]) -> None: ...

    # --- topology operations ---

    def descend(
        self,
        src_dim: int | None = ...,
        target_dim: int | None = ...,
    ) -> UMesh: ...
    def descend_update(
        self,
        src_dim: int | None = ...,
        target_dim: int | None = ...,
    ) -> UMesh | None: ...
    def boundaries(
        self,
        src_dim: int | None = ...,
        target_dim: int | None = ...,
    ) -> UMesh: ...
    def boundaries_update(
        self,
        src_dim: int | None = ...,
        target_dim: int | None = ...,
    ) -> UMesh | None: ...
    def connected_components(
        self,
        src_dim: int | None = ...,
        link_dim: int | None = ...,
        with_fields: bool = ...,
    ) -> list[UMesh]: ...

    # --- measures ---

    def measure(self) -> dict[str, _Array1F]: ...
    def measure_update(self) -> None: ...

    # --- geometric ops ---

    def crack(self, cut_mesh: UMesh) -> UMesh: ...
    def snap(self, reference: UMesh, eps: float = ...) -> UMesh: ...
    def merge_nodes(self, eps: float = ...) -> UMesh: ...
    def remove_unused_coords(self) -> UMesh: ...
    def extrude(self, along: Sequence[float]) -> UMesh: ...
    def extrude_parallel(self, along: _Array2F) -> UMesh: ...
    def extrude_curv(self, along: _Array2F) -> UMesh: ...
    def slice(self, origin: Sequence[float], normal: Sequence[float]) -> UMesh: ...
    def slice_line(
        self, origin: Sequence[float], direction: Sequence[float]
    ) -> UMesh: ...
    def split(self) -> UMesh: ...
    def polyze(self) -> UMesh: ...
    def unpolyze(self) -> UMesh: ...
    def reorient(self) -> UMesh: ...
    def translate(self, v: Sequence[float]) -> UMesh: ...
    def scale(self, factors: Sequence[float]) -> UMesh: ...
    def scale_uniform(self, factor: float) -> UMesh: ...
    def simplexize(self) -> UMesh: ...
    def rotate(self, axis: Sequence[float], angle: float) -> UMesh: ...
    def rotate_about(
        self, center: Sequence[float], axis: Sequence[float], angle: float
    ) -> UMesh: ...
    def mirror(self, normal: Sequence[float]) -> UMesh: ...
    def mirror_about(
        self, point: Sequence[float], normal: Sequence[float]
    ) -> UMesh: ...
    def transform(self, tr: Transform | _Array2F) -> UMesh: ...
    def duplicate(self, step: Transform, n: int) -> UMesh: ...
    def overlay(
        self, mesh2: UMesh, operation: OverlayOperation | None = ...
    ) -> UMesh: ...
    def overlay_surfaces(self, mesh2: UMesh, tol: float = ...) -> SurfaceOverlay: ...

    # --- selection & evaluation ---

    def select(
        self, expr: Selection | str, dim: int | None = None
    ) -> SelectionResult: ...
    def eval(
        self, expr: _FieldInput, dim: int | None = None
    ) -> dict[str, _ArrayDynF]: ...
    def eval_update(
        self, name: str, expr: _FieldInput, dim: int | None = None
    ) -> None: ...

    # --- conversions ---

    def to_pyvista(
        self, dim: str | int | None = None, with_fields: Sequence[str] | bool = True
    ) -> pv.UnstructuredGrid: ...
    def to_mc(self, lev: int | None = None) -> mc.MEDCouplingUMesh: ...
    def to_meshio(self) -> mio.Mesh: ...

